rules_version = '2';

// חוקי אבטחה למסד הנתונים של המחסן.
// מדביקים את כל הקובץ ב: Firebase → Firestore Database → Rules → Publish
// ומחליפים את המייל במייל של חשבון המחסן.

service cloud.firestore {
  match /databases/{database}/documents {
    match /warehouse_items/{id} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'WAREHOUSE_EMAIL_HERE';
    }
    match /warehouse_log/{id} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'WAREHOUSE_EMAIL_HERE';
    }
  }
}
